---
import Layout from '../layouts/Layout.astro';
import { BookOpen, Github } from 'lucide-astro';
---

<Layout title="SchoolNovel">
  <main class="mx-auto flex min-h-screen max-w-3xl flex-col justify-center px-6">
    <div class="flex items-center gap-3 text-brand-600">
      <BookOpen class="size-8" />
      <h1 class="text-3xl font-semibold tracking-tight">SchoolNovel</h1>
    </div>
    <p class="mt-4 text-lg text-gray-600">校园小说阅读站</p>
    <p class="mt-8 text-sm text-gray-500">
      Astro 5 · TypeScript · Tailwind CSS v4 · MDX · Sitemap · Lucide
    </p>
    <a
      class="mt-10 inline-flex w-fit items-center gap-2 text-sm font-medium text-brand-600 hover:text-brand-700"
      href="https://github.com/Yord-XiaBingBao/SchoolNovel"
      target="_blank"
      rel="noreferrer"
    >
      <Github class="size-4" />
      GitHub
    </a>
  </main>
</Layout>
